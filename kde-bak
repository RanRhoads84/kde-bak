#!/usr/bin/env bash
set -euo pipefail

# kde-bak: backup/restore KDE Plasma settings & layouts

APP="kde-bak"
VERSION="1.0.0"

# Set Save location (default: inside the app directory)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
DEFAULT_DEST="${SCRIPT_DIR}/${APP}/backup"
DEFAULT_LOG_DIR="${DEFAULT_DEST}/logs"

# Exit codes
E_USAGE=2
E_IO=3
E_DEP=4
E_ARCHIVE=5
E_RESTORE=6

# Defaults
MODE="backup"
DEST_DIR=""
ARCHIVE=""
DRY_RUN=0
VERBOSE=0
QUIET=0
NO_KSCREEN=0
NO_RESTART_PLASMA=0
MAKE_SNAPSHOT_BEFORE_RESTORE=1
LOG_FILE=""

print_help() {
  cat <<EOF
$APP v$VERSION

Backup and restore KDE Plasma desktop settings, layouts, and related config.

USAGE:
  $APP backup [--dest DIR] [options]
  $APP restore --archive FILE.tar.gz [options]
  $APP list [--dest DIR]
  $APP verify --archive FILE.tar.gz
  $APP -h|--help
  $APP --version

COMMON OPTIONS:
  --dry-run             Show what would happen, change nothing
  -v, --verbose         More output
  -q, --quiet           Less output (errors only)
  --log FILE            Write log output to FILE (default: auto in state dir)

BACKUP OPTIONS:
  --dest DIR            Backup destination dir (default: $DEFAULT_DEST)
  --no-kscreen          Do not include monitor layout files (KScreen)

RESTORE OPTIONS:
  --archive FILE        Backup archive to restore from (required)
  --no-snapshot         Do NOT create a safety snapshot before restore
  --no-restart          Do not restart plasmashell after restore

EXAMPLES:
  Backup:
    $APP backup

  Backup to external drive:
    $APP backup --dest /mnt/backup/kde

  Backup without monitor layouts:
    $APP backup --no-kscreen

  List backups:
    $APP list

  Verify archive:
    $APP verify --archive /mnt/backup/kde/$APP-2025-12-20_14-03-11.tar.gz

  Restore:
    $APP restore --archive /mnt/backup/kde/$APP-2025-12-20_14-03-11.tar.gz

NOTES:
  - Best restore results come from restoring to the same user account.
  - If Plasma acts weird after restore, log out/in.
  - KScreen can reorder monitors. Use --no-kscreen if you want peace.
EOF
}

say()  { (( QUIET )) || echo "$*"; }
info() { (( QUIET )) || echo "[*] $*"; }
ok()   { (( QUIET )) || echo "[+] $*"; }
warn() { echo "[!] $*" >&2; }
err()  { echo "[x] $*" >&2; }

die() {
  local code="$1"; shift
  err "$*"
  exit "$code"
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "$E_DEP" "Missing required command: $1"
}

run() {
  if (( DRY_RUN )); then
    say "[dry-run] $*"
    return 0
  fi
  (( VERBOSE )) && say "[cmd] $*"
  eval "$@"
}

ts() { date +"%Y-%m-%d_%H-%M-%S"; }

set_logging() {
  mkdir -p "$DEFAULT_LOG_DIR"
  if [[ -z "$LOG_FILE" ]]; then
    LOG_FILE="${DEFAULT_LOG_DIR}/${APP}-$(ts).log"
  fi

  if (( QUIET )); then
    exec > >(tee -a "$LOG_FILE" >/dev/null) 2> >(tee -a "$LOG_FILE" >&2)
  else
    exec > >(tee -a "$LOG_FILE") 2> >(tee -a "$LOG_FILE" >&2)
  fi
}

detect_plasma_quit_cmd() {
  if command -v kquitapp6 >/dev/null 2>&1; then echo "kquitapp6"; return 0; fi
  if command -v kquitapp5 >/dev/null 2>&1; then echo "kquitapp5"; return 0; fi
  echo ""
}

plasmashell_restart() {
  if (( NO_RESTART_PLASMA )); then
    info "Skipping plasmashell restart (--no-restart)"
    return 0
  fi

  local kquit
  kquit="$(detect_plasma_quit_cmd)"

  if [[ -n "$kquit" ]]; then
    info "Stopping plasmashell..."
    run "$kquit plasmashell || true"
  else
    warn "kquitapp not found; attempting best-effort plasmashell restart"
  fi

  run "sleep 1"
  info "Starting plasmashell..."
  run "(nohup plasmashell >/dev/null 2>&1 & ) || true"
}

backup_curated_rsync() {
  local src="$1"
  local outdir="$2"

  [[ -d "$src" ]] || return 0

  local includes=(
    '*/'
    'plasma*'
    'k*'
    'kwin*'
    'ksmserver*'
    'dolphin*'
    'konsole*'
    'systemsettings*'
    'gtkrc*'
    'Trolltech.conf'
    'qt*'
    '*rc'
  )

  if (( NO_KSCREEN )); then
    :
  else
    includes+=('kscreen*')
  fi

  local rsync_inc=""
  for i in "${includes[@]}"; do
    rsync_inc+=" --include='$i'"
  done

  run "rsync -a --relative --exclude='**/backup/**' $rsync_inc --exclude='*' '$src/' '$outdir/home/' >/dev/null"
}

backup_asset_dirs() {
  local outdir="$1"

  local asset_dirs=(
    "$HOME/.local/share/wallpapers"
    "$HOME/.local/share/icons"
    "$HOME/.local/share/plasma"
    "$HOME/.local/share/themes"
    "$HOME/.local/share/plasmoids"
  )

  info "Saving user asset directories (wallpapers/icons/themes)..."
  for src in "${asset_dirs[@]}"; do
    [[ -d "$src" ]] || continue
    run "rsync -a --relative --exclude='**/backup/**' '$src/' '$outdir/home/'"
  done
}

make_backup() {
  local dest="${DEST_DIR:-$DEFAULT_DEST}"
  local stamp
  stamp="$(ts)"
  local outdir="${dest}/${stamp}"
  local tarball="${dest}/${APP}-${stamp}.tar.gz"

  need_cmd rsync
  need_cmd tar
  mkdir -p "$outdir"

  ok "Backup destination: $outdir"
  info "Creating metadata..."

  run "cat > '$outdir/METADATA.txt' <<'META'
timestamp=${stamp}
host=$(hostname)
user=${USER}
kernel=$(uname -r)
plasma_version=$(plasmashell --version 2>/dev/null || true)
kde_frameworks=$(kde-config --version 2>/dev/null | head -n 1 || true)
no_kscreen=${NO_KSCREEN}
META"

  info "Saving Plasma layout (panels/widgets)..."
  run "mkdir -p '$outdir/home/.config'"
  if [[ -f "$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc" ]]; then
    run "cp -a '$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc' '$outdir/home/.config/'"
  else
    warn "Layout file not found: ~/.config/plasma-org.kde.plasma.desktop-appletsrc"
  fi

  info "Saving curated KDE config..."
  backup_curated_rsync "$HOME/.config" "$outdir"
  backup_curated_rsync "$HOME/.local/share" "$outdir"
  backup_curated_rsync "${XDG_STATE_HOME:-$HOME/.local/state}" "$outdir"

  # Save user asset directories so restores don't reference missing files
  backup_asset_dirs "$outdir"

  local extras=(
    "$HOME/.config/kglobalshortcutsrc"
    "$HOME/.config/khotkeysrc"
    "$HOME/.config/ksmserverrc"
    "$HOME/.config/kwinrc"
    "$HOME/.config/plasmarc"
    "$HOME/.config/kactivitymanagerdrc"
    "$HOME/.config/kactivitymanagerd-statsrc"
  )

  info "Saving extra high-value config files..."
  for f in "${extras[@]}"; do
    [[ -f "$f" ]] || continue
    run "mkdir -p '$outdir/home/$(dirname "${f#"$HOME/"}")'"
    run "cp -a '$f' '$outdir/home/${f#"$HOME/"}'"
  done

  info "Creating archive..."
  run "tar -C '$dest' -czf '$tarball' '$stamp'"

  ok "Backup complete"
  ok "Archive: $tarball"
  ok "Log:     $LOG_FILE"
}

list_backups() {
  local dest="${DEST_DIR:-$DEFAULT_DEST}"
  [[ -d "$dest" ]] || die "$E_IO" "Destination does not exist: $dest"
  say "Backups in: $dest"
  ls -1t "$dest"/"$APP"-*.tar.gz 2>/dev/null || say "(none found)"
}

verify_archive() {
  need_cmd tar
  [[ -n "$ARCHIVE" ]] || die "$E_USAGE" "verify requires --archive FILE"
  [[ -f "$ARCHIVE" ]] || die "$E_ARCHIVE" "Archive not found: $ARCHIVE"
  info "Verifying archive integrity..."
  run "tar -tzf '$ARCHIVE' >/dev/null"
  ok "Archive OK: $ARCHIVE"
}

extract_archive_to_tmp() {
  need_cmd tar
  local archive="$1"
  if (( DRY_RUN )); then
    local top
    top="$(tar -tzf "$archive" 2>/dev/null | head -n 1 || true)"
    top="${top%%/*}"
    [[ -n "$top" ]] || die "$E_ARCHIVE" "Invalid archive format (missing timestamp directory)"
    # Use a placeholder path so later dry-run commands look realistic.
    echo "(dry-run)|/tmp/${APP}-dry-run/${top}"
    return 0
  fi
  local tmp
  tmp="$(mktemp -d)"
  run "tar -xzf '$archive' -C '$tmp'"

  local stampdir
  stampdir="$(find "$tmp" -maxdepth 1 -type d -name "20*" | head -n 1 || true)"
  [[ -n "$stampdir" ]] || die "$E_ARCHIVE" "Invalid archive format (missing timestamp directory)"

  echo "$tmp|$stampdir"
}

snapshot_before_restore() {
  (( MAKE_SNAPSHOT_BEFORE_RESTORE )) || return 0
  info "Creating safety snapshot before restore..."
  local old_mode="$MODE"
  local old_dest="$DEST_DIR"

  MODE="backup"
  DEST_DIR="${DEFAULT_DEST}"
  make_backup

  MODE="$old_mode"
  DEST_DIR="$old_dest"
}

restore_archive() {
  need_cmd rsync

  if [[ -z "$ARCHIVE" ]]; then
    local dest="${DEST_DIR:-$DEFAULT_DEST}"
    [[ -d "$dest" ]] || die "$E_IO" "Destination does not exist: $dest"

    local recent
    recent="$(ls -1t "$dest"/${APP}-*.tar.gz 2>/dev/null | head -n 1 || true)"
    if [[ -z "$recent" ]]; then
      die "$E_ARCHIVE" "No backups found in: $dest"
    fi

    say "No --archive given. Choose restore source:"
    say "  1) Most recent: ${recent}"
    say "  2) Specify path"
    say "  3) Cancel"

    if (( DRY_RUN )); then
      say "[dry-run] would restore: ${recent}"
      ARCHIVE="$recent"
    else
      read -rp "Select option [1-3]: " opt
      case "$opt" in
        1|"") ARCHIVE="$recent" ;;
        2) read -rp "Enter archive path: " ARCHIVE ;;
        *) die "$E_USAGE" "Restore cancelled" ;;
      esac
    fi
  fi

  [[ -f "$ARCHIVE" ]] || die "$E_ARCHIVE" "Archive not found: $ARCHIVE"

  verify_archive
  snapshot_before_restore

  info "Extracting archive..."
  local parts tmp stampdir
  parts="$(extract_archive_to_tmp "$ARCHIVE")"
  tmp="${parts%%|*}"
  stampdir="${parts#*|}"

  info "Restoring files into \$HOME (merge restore, does not delete unrelated files)..."
  run "rsync -a '${stampdir}/home/' '$HOME/'"

  plasmashell_restart

  ok "Restore complete"
  ok "Log: $LOG_FILE"
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      backup|restore|list|verify)
        MODE="$1"; shift
        ;;
      --dest)
        DEST_DIR="${2:-}"; [[ -n "$DEST_DIR" ]] || die "$E_USAGE" "--dest requires a directory"
        shift 2
        ;;
      --archive)
        ARCHIVE="${2:-}"; [[ -n "$ARCHIVE" ]] || die "$E_USAGE" "--archive requires a file"
        shift 2
        ;;
      --dry-run)
        DRY_RUN=1; shift
        ;;
      -v|--verbose)
        VERBOSE=1; shift
        ;;
      -q|--quiet)
        QUIET=1; shift
        ;;
      --no-kscreen)
        NO_KSCREEN=1; shift
        ;;
      --no-restart)
        NO_RESTART_PLASMA=1; shift
        ;;
      --no-snapshot)
        MAKE_SNAPSHOT_BEFORE_RESTORE=0; shift
        ;;
      --log)
        LOG_FILE="${2:-}"; [[ -n "$LOG_FILE" ]] || die "$E_USAGE" "--log requires a file path"
        shift 2
        ;;
      -h|--help)
        print_help
        exit 0
        ;;
      --version)
        echo "$APP $VERSION"
        exit 0
        ;;
      *)
        die "$E_USAGE" "Unknown argument: $1 (use --help)"
        ;;
    esac
  done
}

main() {
  parse_args "$@"
  set_logging

  case "$MODE" in
    backup)  make_backup ;;
    restore) restore_archive ;;
    list)    list_backups ;;
    verify)  verify_archive ;;
    *) die "$E_USAGE" "Unknown mode: $MODE" ;;
  esac
}

main "$@"
